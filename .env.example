# Postgres 接続文字列（本番は Neon など）
DATABASE_URL="postgresql://postgres@localhost:5432/comadori"
# アプリの公開URL（Google OAuth のリダイレクト先に使う）
APP_URL="http://localhost:3000"
# セッション署名用のランダム文字列
SESSION_SECRET=""
# ログインを許可する所有者のメールアドレス（予約通知の宛先にもなる）
OWNER_EMAIL=""
# Google Cloud Console で作る OAuth クライアント。空なら開発用ログインになる
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# メールの送り方（どちらも空ならメールは送らずサーバーログに出す）
# A. Gmail から送る：SMTP_USER に Gmail アドレス、SMTP_PASS に Google の「アプリ パスワード」（2段階認証が必要）
SMTP_USER=""
SMTP_PASS=""
# Gmail 以外の SMTP を使うときだけ指定する（初期値は smtp.gmail.com と 465）
SMTP_HOST=""
SMTP_PORT=""
# B. Resend から送る（送信先を自由にするには独自ドメインの認証が必要）
RESEND_API_KEY=""
MAIL_FROM="Comadori <onboarding@resend.dev>"
