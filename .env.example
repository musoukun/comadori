# Postgres 接続文字列（本番は Neon など）
DATABASE_URL="postgresql://postgres@localhost:5432/comadori"
# アプリの公開URL（Google OAuth のリダイレクト先に使う）
APP_URL="http://localhost:3000"
# セッション署名用のランダム文字列
SESSION_SECRET=""
# ログインを許可する所有者のメールアドレス（予約通知の宛先にもなる）
OWNER_EMAIL=""
# Google Cloud Console で作る OAuth クライアント。空なら開発用ログインになる
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 空ならメールは送らずサーバーログに出す
RESEND_API_KEY=""
MAIL_FROM="Comadori <onboarding@resend.dev>"
