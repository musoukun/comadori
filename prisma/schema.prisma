generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// カレンダーの所有者。版番号は仮押さえを1件ずつ並べるために使う
model Owner {
  id                 String    @id @default(cuid())
  email              String    @unique
  /** 共有リンク /b/[slug] の識別子。相手はこのリンクから登録・ログインする */
  slug               String    @unique
  googleRefreshToken String?
  /** Google で許可されたスコープ（空白区切り） */
  googleScopes       String?
  /** 受付の終了時刻（0時からの分）。未設定なら設定ファイルの初期値 */
  dayEndMinutes      Int?
  version            Int       @default(0)
  createdAt          DateTime  @default(now())
  guests             Guest[]
  blocks             Block[]
  bookings           Booking[]
}

// 予定を入れる側の相手。色は本人が空いている色から選ぶ。カレンダーに出す予定名は所有者が決める
model Guest {
  id           String    @id @default(cuid())
  ownerId      String
  owner        Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  colorId      String
  maskTitle    String
  createdAt    DateTime  @default(now())
  bookings     Booking[]

  @@unique([ownerId, email])
  @@unique([ownerId, colorId])
}

// 所有者が手動でふさいだ時間帯
model Block {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())

  @@index([ownerId, startAt])
}

enum BookingStatus {
  HELD
  CONFIRMED
}

// 相手の予約。HELD は期限付きの仮押さえ。予定名と名前は仮押さえの時点で相手の設定から写す
model Booking {
  id            String        @id @default(cuid())
  ownerId       String
  owner         Owner         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  guestId       String?
  guest         Guest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)
  startAt       DateTime
  endAt         DateTime
  status        BookingStatus
  title         String
  guestName     String
  holdExpiresAt DateTime?
  note          String?
  googleEventId String?
  createdAt     DateTime      @default(now())
  confirmedAt   DateTime?

  @@index([ownerId, startAt])
}
